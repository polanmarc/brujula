# ---------- Obligatorias ----------

# Supabase - Conexión principal (Project Settings -> API)
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Clave secreta de servicio (Service Role Key) de Supabase. ¡Nunca en el navegador!
SUPABASE_SERVICE_ROLE_KEY=""

# Variables públicas para Vite (mismos valores que arriba)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# URL pública de la app, sin barra final (se usa en el OAuth de Google, emails y feeds)
APP_URL="http://localhost:3000"

# Clave para cifrar los tokens de Google guardados en la base de datos.
# Genérala con: openssl rand -base64 32   (32 bytes en base64; no la cambies después o habrá que reconectar Gmail)
TOKEN_ENCRYPTION_KEY=""

# ---------- Opcionales ----------

# Gmail por usuario (Google Cloud Console -> Credenciales -> ID de cliente OAuth "Aplicación web")
# URI de redirección autorizada: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# IA (Claude): resumen de correos, importar guías docentes y plan semanal
ANTHROPIC_API_KEY=""
# Peticiones de IA por usuario cada 24 h (por defecto 30)
AI_DAILY_LIMIT="30"

# Notificaciones push (Web Push). Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# Resumen diario por email (Resend: https://resend.com, con dominio verificado)
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="Brújula <avisos@tu-dominio.com>"

# Tareas programadas: POST /api/cron/sync (calendarios) y POST /api/cron/notify (recordatorios)
# Configúralo también en tu proveedor de cron como: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Secreto anterior durante una rotación (opcional): ambos se aceptan temporalmente.
CRON_SECRET_PREVIOUS=""
